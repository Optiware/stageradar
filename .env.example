# Copier ce fichier en `.env` (à la racine) et remplir les valeurs.
# `.env` est ignoré par git. Ne jamais committer de clé.

# --- Déploiement sur le VPS (`npm run deploy`) -------------------------------
# Connexion SSH au serveur, par clé (aucun mot de passe n'est demandé).
DEPLOY_SSH=root@adresse-du-serveur
# Nom de domaine qui pointe vers le serveur : le certificat HTTPS est demandé pour ce nom.
DEPLOY_DOMAINE=stageradar.exemple.fr
# Adresse du compte propriétaire : simple identifiant de connexion, aucun e-mail n'est envoyé.
PROPRIETAIRE_EMAIL=moi@exemple.fr

# --- Développement local (facultatif, voir README « Pile locale ») -----------
# Seules les variables préfixées VITE_ sont embarquées dans le front.
# En production, `npm run deploy` les fournit lui-même : ces lignes ne servent qu'à `npm run dev`.
VITE_SUPABASE_URL=http://localhost:5173
# Clé publique : valeur de ANON_KEY dans deploy/serveur/.env. La sécurité repose sur la RLS.
VITE_SUPABASE_KEY=

# --- Collecteur (packages/collector) ----------------------------------------
# Sur le serveur, le collecteur lit /opt/stageradar/.env : rien à remplir ici pour la production.
# En local : adresse de l'API REST et clé secrète (SERVICE_ROLE_KEY de deploy/serveur/.env).
# Cette clé contourne la RLS : JAMAIS dans une variable VITE_.
SUPABASE_URL=http://127.0.0.1:54332
SUPABASE_SERVICE_ROLE_KEY=

# Les clés des sources (La bonne alternance, France Travail, VAPID…)
# seront ajoutées ici au fil des lots.
