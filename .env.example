# Copier ce fichier en `.env` (à la racine) et remplir les valeurs.
# `.env` est ignoré par git. Ne jamais committer de clé.
#
# Seules les variables préfixées VITE_ sont embarquées dans le front.
# Tout le reste n'est lu que par le collecteur (Node) et ne quitte jamais ta machine
# ou les secrets GitHub.

# --- Front (apps/web) -------------------------------------------------------
# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys > clé publique (« publishable », anciennement « anon »).
# Elle est faite pour être publique : la sécurité repose sur la RLS.
VITE_SUPABASE_KEY=

# --- Collecteur (packages/collector) ----------------------------------------
# Même URL que ci-dessus.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API Keys > clé secrète (« secret », anciennement « service_role »).
# Contourne la RLS : uniquement ici et dans les secrets GitHub, JAMAIS dans une variable VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Les clés des sources (Adzuna, La bonne alternance, France Travail, VAPID…)
# seront ajoutées ici au fil des lots.
